name: Build SokoLink APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Download project
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Prepare project
        run: |
          unzip -o SokoLink_Android_Studio_Project.zip -d project
          echo "Project files:"
          find project -maxdepth 4 -type f | head -100

      - name: Build APK
        run: |
          cd project
          GRADLE_FILE=$(find . -name gradlew -type f | head -1)
          if [ -z "$GRADLE_FILE" ]; then
            echo "No Gradle wrapper found. Project needs inspection."
            exit 1
          fi
          chmod +x "$GRADLE_FILE"
          cd "$(dirname "$GRADLE_FILE")"
          ./gradlew assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: SokoLink-APK
          path: project/**/*.apk
